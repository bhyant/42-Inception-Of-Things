IP_CONTROLLER = "192.168.56.110"
IP_AGENT = "192.168.56.111"
LOGIN = "tbhuiyan"


Vagrant.configure("2") do |config|
  config.vm.box = "cloud-image/debian-13"
  config.vm.synced_folder ".", "/vagrant", disabled: true
  config.vm.synced_folder "./secrets/", "/secrets/", create: true, type: "virtiofs"
  config.ssh.insert_key = true
  config.vm.provider :libvirt do |libvirt|
    libvirt.driver = "kvm"
    libvirt.uri = 'qemu:///system'
    libvirt.memorybacking :source, :type => 'memfd'
    libvirt.memorybacking :access, :mode => 'shared'
    libvirt.default_prefix = ""
    libvirt.cpus = 1
  end

  config.vm.define "#{LOGIN}S" do |control|
    control.vm.hostname = "#{LOGIN}S"
    control.vm.network :private_network, ip: IP_CONTROLLER
    control.vm.provision "shell", path: "./scripts/init_server.sh", env: { "CONTROLLER_IP" => IP_CONTROLLER }
    control.vm.provider :libvirt do |libvirt|
      libvirt.memory = 1024
    end
  end

  config.vm.define "#{LOGIN}SW" do |agent|
    agent.vm.hostname = "#{LOGIN}SW"
    agent.vm.network :private_network, ip: IP_AGENT
    agent.vm.provision "shell", path: "./scripts/init_agent.sh", env: { "K3S_URL" => "https://#{IP_CONTROLLER}:6443", "AGENT_IP" => IP_AGENT }
    agent.vm.provider :libvirt do |libvirt|
      libvirt.memory = 512
    end
  end
end
